<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Bicycle Rental</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/bicycles">
                <span class="fa fa-solid fa-bicycle" aria-hidden="true"></span> Велосипеды
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/bicycle-models">
                <span class="fa fa-solid fa-list" aria-hidden="true"></span> Модели
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/renters">
                <span class="fa fa-solid fa-user" aria-hidden="true"></span> Арендаторы
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/rentals">
                <span class="fa fa-solid fa-history" aria-hidden="true"></span> Аренды
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
}