<DataGrid TItem="RenterDto"
          Data="Items"
          Responsive
          Striped
          Scrollable="true"
          ScrollHeight="480px"
          Virtualize="true"
          ShowPager="false">

    <DataGridColumns>
        <DataGridColumn TItem="RenterDto" Field="@nameof(RenterDto.Id)" Caption="#" ReadOnly />
        <DataGridColumn TItem="RenterDto" Field="@nameof(RenterDto.LastName)" Caption="Фамилия" />
        <DataGridColumn TItem="RenterDto" Field="@nameof(RenterDto.FirstName)" Caption="Имя" />
        <DataGridColumn TItem="RenterDto" Field="@nameof(RenterDto.Patronymic)" Caption="Отчество" />
        <DataGridColumn TItem="RenterDto" Field="@nameof(RenterDto.Phone)" Caption="Телефон" />

        <DataGridColumn TItem="RenterDto" Caption="Действия">
            <DisplayTemplate>
                <Button Color="Color.Primary" Size="Size.Small" Clicked="@(() => OnEditClicked(context))">Изменить</Button>
                <Button Color="Color.Danger" Size="Size.Small" Margin="Margin.Is2.FromStart" Clicked="@(() => OnDeleteClicked(context.Id))">Удалить</Button>
            </DisplayTemplate>
        </DataGridColumn>
    </DataGridColumns>
</DataGrid>

@code {
    [Parameter] public IList<RenterDto> Items { get; set; } = new List<RenterDto>();
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public EventCallback<RenterDto> OnEdit { get; set; }

    private async Task OnDeleteClicked(int id)
    {
        if (OnDelete.HasDelegate)
            await OnDelete.InvokeAsync(id);
    }

    private async Task OnEditClicked(RenterDto renter)
    {
        if (OnEdit.HasDelegate)
            await OnEdit.InvokeAsync(renter);
    }
}
