<DataGrid TItem="RentalDto"
          Data="Items"
          Responsive
          Striped
          Scrollable="true"
          ScrollHeight="480px"
          Virtualize="true"
          ShowPager="false">

    <DataGridColumns>
        <DataGridColumn TItem="RentalDto" Field="@nameof(RentalDto.Id)" Caption="#" ReadOnly />

        <DataGridColumn TItem="RentalDto" Field="@nameof(RentalDto.BicycleId)" Caption="Велосипед">
            <DisplayTemplate>
                @(BikeMap.TryGetValue(context.BicycleId, out var bn) ? bn : $"#{context.BicycleId}")
            </DisplayTemplate>
        </DataGridColumn>

        <DataGridColumn TItem="RentalDto" Field="@nameof(RentalDto.RenterId)" Caption="Арендатор">
            <DisplayTemplate>
                @(RenterMap.TryGetValue(context.RenterId, out var rn) ? rn : $"#{context.RenterId}")
            </DisplayTemplate>
        </DataGridColumn>

        <DataGridColumn TItem="RentalDto" Field="@nameof(RentalDto.StartAt)" Caption="Начало" />
        <DataGridColumn TItem="RentalDto" Field="@nameof(RentalDto.DurationHours)" Caption="Длительность" />
        <DataGridColumn TItem="RentalDto" Field="@nameof(RentalDto.TotalPrice)" Caption="Итог" ReadOnly />

        <DataGridColumn TItem="RentalDto" Caption="Действия">
            <DisplayTemplate>
                <Button Color="Color.Primary" Size="Size.Small" Clicked="@(() => OnEditClicked(context))">
                    Изменить
                </Button>
                <Button Color="Color.Danger" Size="Size.Small" Margin="Margin.Is2.FromStart" Clicked="@(() => OnDeleteClicked(context.Id))">
                    Удалить
                </Button>
            </DisplayTemplate>
        </DataGridColumn>
    </DataGridColumns>
</DataGrid>

@code {
    [Parameter] public IList<RentalDto> Items { get; set; } = new List<RentalDto>();
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public EventCallback<RentalDto> OnEdit { get; set; }

    [Parameter] public Dictionary<int, string> BikeMap { get; set; } = new();
    [Parameter] public Dictionary<int, string> RenterMap { get; set; } = new();

    private async Task OnDeleteClicked(int id)
    {
        if (OnDelete.HasDelegate)
            await OnDelete.InvokeAsync(id);
    }

    private async Task OnEditClicked(RentalDto rental)
    {
        if (OnEdit.HasDelegate)
            await OnEdit.InvokeAsync(rental);
    }
}
