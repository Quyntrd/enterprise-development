@typeparam TItem

<DataGrid TItem="BicycleDto"
          Data="Items"
          Responsive
          Striped
          Scrollable="true"
          ScrollHeight="480px"
          Virtualize="true"
          ShowPager="false">
    <DataGridColumns>
        <DataGridColumn TItem="BicycleDto" Field="@nameof(BicycleDto.Id)" Caption="#" />
        <DataGridColumn TItem="BicycleDto" Field="@nameof(BicycleDto.SerialNumber)" Caption="Серийный номер" />
        <DataGridColumn TItem="BicycleDto" Field="@nameof(BicycleDto.Color)" Caption="Цвет" />
        <DataGridColumn TItem="BicycleDto" Caption="Действия">
            <DisplayTemplate>
                <Button Color="Color.Danger"
                        Size="Size.Small"
                        Clicked="() => OnDeleteRequested(context.Id)">
                    Удалить
                </Button>
            </DisplayTemplate>
        </DataGridColumn>
    </DataGridColumns>
</DataGrid>


@code {
    [Parameter] public IList<BicycleDto> Items { get; set; } = new List<BicycleDto>();
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    private async Task OnDeleteRequested(int id)
    {
        if (OnDelete.HasDelegate)
            await OnDelete.InvokeAsync(id);
    }
}
